{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "move_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "enum": [
        "keep",
        "reject",
        "neither",
        "failed"
      ]
    },
    "source": {
      "enum": [
        "user",
        "action_layer"
      ]
    },
    "user_words": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "auditioned": {
      "type": "boolean"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "request_id",
    "result_id",
    "move_id",
    "decision",
    "source",
    "user_words",
    "evidence_ids",
    "auditioned",
    "reason",
    "created_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "const": "action_layer"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "source": {
            "const": "user"
          },
          "user_words": {
            "type": "string",
            "minLength": 1
          },
          "auditioned": {
            "const": true
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrunch.local/contracts/v1/keep-reject-decision.json"
}
